{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MakeCode: Set up extension dependencies",
            "type": "shell",
            "command": "node",
            "windows": {
                "command": "${workspaceFolder}/scripts/run-node.cmd"
            },
            "args": [
                "scripts/makecode.cjs",
                "setup"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
