            "command": "node",
            "args": [
                "scripts/makecode.cjs",
                "serve"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "windows": {
                "command": "${workspaceFolder}/scripts/run-node.cmd"
            }
        },
